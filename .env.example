# Supabase PostgreSQL
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# Supabase (للواجهة الأمامية)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_YOUR_KEY"

# سر توقيع الجلسات
AUTH_SECRET="CHANGE_ME_TO_A_RANDOM_SECRET"

# بيانات الأدمن (اختياري)
ADMIN_EMAIL="admin@syntax.eg"
ADMIN_PASSWORD="Admin@12345"

# رابط الموقع
NEXT_PUBLIC_SITE_URL="https://your-domain.vercel.app"

# Google OAuth
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
GOOGLE_CALLBACK_URL="https://your-domain.vercel.app/auth/google"
